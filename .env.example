# Postgres (Neon) — get the DIRECT (non-pooled) connection string from
# https://console.neon.tech (pooled/pgbouncer strings need extra config to
# work with Prisma's node-postgres adapter, so stick to direct for MVP).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/splits
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/splits
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Uploadthing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
