# Server-only unless prefixed NEXT_PUBLIC_. Never commit real values.
# In Vercel, add every secret as a Sensitive environment variable.

# Postgres (Neon). TabMath uses the DIRECT (non-pooled) string for both: pooled
# strings hit a prepared-statement issue with the pg adapter here (see AGENTS.md).
# Use the least-privilege app role (prisma/sql/app-role.sql), not the owner.
DATABASE_URL="postgresql://tabmath_app:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
# Used by the Prisma CLI and the build-time drift check (required on Vercel).
DIRECT_URL="postgresql://tabmath_app:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Clerk: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/splits
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/splits
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Uploadthing: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
